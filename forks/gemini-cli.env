# shellcheck shell=bash disable=SC2034,SC2016
# acp-fork-sync settings for Black-Dragon-Foundation/gemini-cli, sourced by sync.sh
FORK_REPO=Black-Dragon-Foundation/gemini-cli
UPSTREAM_URL=https://github.com/google-gemini/gemini-cli
UPSTREAM_BRANCH=main
# the weekly stable and its patches: v0.67.0, not v0.68.0-preview.0 or v0.67.0-nightly.*
TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+$'
NODE_VERSION=20
# build (typecheck needs it), type-check, lint, then the ACP tests and the client test the patch touches
CHECK_CMD='npm ci --no-audit --no-fund &&
  npm run build &&
  npm run typecheck &&
  npm run lint &&
  npm test -w packages/cli -- --maxWorkers=2 src/acp &&
  npm test -w packages/core -- --maxWorkers=2 src/core/client.test.ts'
# the root package: the single-file bundle (cli and core, with our patch), as upstream publishes it
PACK_CMD='npm run bundle &&
  npm pack --ignore-scripts --pack-destination "$PACK_TMP" &&
  bash "$SYNC_HOME/pack-shrinkwrap.sh" "$PACK_TMP"/*.tgz "$PACK_OUT"'
