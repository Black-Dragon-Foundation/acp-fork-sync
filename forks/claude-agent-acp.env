# shellcheck shell=bash disable=SC2034,SC2016
# acp-fork-sync settings for Black-Dragon-Foundation/claude-agent-acp, sourced by sync.sh
FORK_REPO=Black-Dragon-Foundation/claude-agent-acp
UPSTREAM_URL=https://github.com/agentclientprotocol/claude-agent-acp
UPSTREAM_BRANCH=main
# stable releases only: v0.101.0, not v0.101.1-preview.1
TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+$'
NODE_VERSION=22
# the drgnx-panel tests and the suite they extend, then type-check, lint and format
CHECK_CMD='npm ci --no-audit --no-fund &&
  npx vitest run --maxWorkers=2 src/tests/drgnx-panel.test.ts src/tests/acp-v2.test.ts &&
  npx tsc --noEmit &&
  npm run lint &&
  npm run format:check'
# a single package: its own lockfile becomes the shrinkwrap, so users get the versions that were tested
# (package.json lists "files", so the shrinkwrap must be added to that list or npm leaves it out)
PACK_CMD='npm run build &&
  npm shrinkwrap &&
  npm pkg set "files[]=npm-shrinkwrap.json" &&
  npm pack --ignore-scripts --pack-destination "$PACK_OUT"'
