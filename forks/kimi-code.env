# shellcheck shell=bash disable=SC2034,SC2016
# acp-fork-sync settings for Black-Dragon-Foundation/kimi-code, sourced by sync.sh
FORK_REPO=Black-Dragon-Foundation/kimi-code
UPSTREAM_URL=https://github.com/MoonshotAI/kimi-code
UPSTREAM_BRANCH=main
# the CLI's stable releases only: @moonshot-ai/kimi-code@2.5.2, not ...@2.6.0-canary.*
TAG_PATTERN='^@moonshot-ai/kimi-code@[0-9]+\.[0-9]+\.[0-9]+$'
NODE_VERSION=24
# pnpm from package.json's packageManager; acp-server's type-check and tests, then the repo's lint
CHECK_CMD='corepack enable &&
  pnpm install --frozen-lockfile &&
  pnpm exec tsc -p packages/acp-server/tsconfig.json --noEmit &&
  pnpm --filter @moonshot-ai/acp-server exec vitest run --maxWorkers=2 &&
  pnpm run lint'
# the CLI package (its build bundles the workspace, acp-server included)
PACK_CMD='pnpm run build &&
  pnpm --filter @moonshot-ai/kimi-code pack --pack-destination "$PACK_TMP" &&
  bash "$SYNC_HOME/pack-shrinkwrap.sh" "$PACK_TMP"/*.tgz "$PACK_OUT"'
