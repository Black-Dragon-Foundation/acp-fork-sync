# shellcheck shell=bash disable=SC2034,SC2016
# acp-fork-sync settings for Black-Dragon-Foundation/deepseek-harness, sourced by sync.sh.
# Not in the schedule: DSH is a developer preview with promised breaks, and drgnx pins one exact pre-release, so each
# move is a manual run naming the tag (README, "DeepSeek by hand").
FORK_REPO=Black-Dragon-Foundation/deepseek-harness
UPSTREAM_URL=https://github.com/deepseek-ai/deepseek-harness
UPSTREAM_BRANCH=master
# releases and release candidates, never alphas: dsh-v0.2.2-rc.1
TAG_PATTERN='^dsh-v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$'
NODE_VERSION=24
# pnpm from package.json's packageManager; the ACP packages' tests, the keyless ACP snapshots, type-check, lint
CHECK_CMD='corepack enable &&
  pnpm install --frozen-lockfile &&
  pnpm run build:native-system &&
  pnpm exec vitest run --maxWorkers=2 packages/acp &&
  pnpm run test:snapshot -t acp &&
  pnpm run typecheck &&
  pnpm run lint'
# No package yet: @deepseek-ai/dsh-acp depends on workspace packages that aren't on npm (our ask plugin among them),
# so it can't be shrinkwrapped on its own. Releases carry no tarball until it has a bundle.
PACK_CMD=''
